generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoProduto {
  COMUM
  EPI
}

}

modelmodel User {
  id                     String nome                  String
  email                 String           @uniqueunique
  senha senha                 String
  produtos              Produto[]
  funcionarios funcionarios funcionarios funcionarios          Func FuncIdentifier
  entregasResponsavel   EntregaProduto[] @relation("ResponsavelEntrega")
  criado criadoMixed
  criado createdEm            String       DateTime     @defaultennials default Outdoor Seating @defaultdefault(now Waltz @map("criadoEm")
  updated actualizado atualizadoEm          DateTime         @updatedAt

  @@map("usuarios")
}

model Produto {
  id             String           @idid @ @ @defaultdefault(uuidContemporary @map("produtoId")
  nome           String
  preco          Decimal          @db.Decimal(10, 2)
  qnt            Int
  tipo           TipoProduto      @default(COMUM)

  estoqueMinimo  Int              @default(0)
  ca             String?
  validadeCA     DateTime?
  lote           String?
  tamanho        String?
  fabricante     String?

  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  entregas       EntregaProduto[]

  criadoEm       DateTime         @default(now())
  atualizadoEm   DateTime         @updatedAt

  @@index([userId])
  @@index([tipo])
  @@index([ca])
  @@map("produtos")
}

model Funcionario {
  id           String           @id @default(uuid())
  nome         String
  cpf          String?
  matricula    String
  cargo        String
  setor        String
  ativo        Boolean          @default(true)

  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  entregas     EntregaProduto[]

  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  @@unique([userId, matricula])
  @@unique([userId, cpf])
  @@index([userId])
  @@map("funcionarios")
}

model EntregaProduto {
  id             String      @id @default(uuid())
  quantidade     Int
  entregueEm     DateTime    @default(now())
  devolvidoEm    DateTime?
  observacao     String?

  funcionarioId  String
  funcionario    Funcionario @relation(
    fields: [funcionarioId],
    references: [id],
    onDelete: Restrict
  )

  produtoId      String
  produto        Produto     @relation(
    fields: [produtoId],
    references: [id],
    onDelete: Restrict
  )

  responsavelId  String
  responsavel    User        @relation(
    "ResponsavelEntrega",
    fields: [responsavelId],
    references: [id],
    onDelete: Restrict
  )

  @@index([funcionarioId])
  @@index([produtoId])
  @@index([responsavelId])
  @@index([entregueEm])
  @@map("entregas_produtos")
}